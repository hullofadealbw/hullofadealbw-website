---
const services = [
  {
    icon: '🛥️',
    title: 'Fiberglass Repair',
    description:
      'Cracks, gouges, stress fractures — we fix them right. Structural repairs that hold up season after season.',
  },
  {
    icon: '🎨',
    title: 'Gelcoat Restoration',
    description:
      'Bring back that showroom shine. We sand, compound, and re-gel faded or oxidized hulls to like-new condition.',
  },
  {
    icon: '🖌️',
    title: 'Bottom Paint & Hull Coating',
    description:
      'Antifouling bottom paint applied correctly to protect your hull and keep you moving fast all season.',
  },
  {
    icon: '⚙️',
    title: 'Engine Service & Repair',
    description:
      'Tune-ups, impeller replacements, winterization, and troubleshooting for inboard and outboard engines.',
  },
  {
    icon: '⚡',
    title: 'Electrical Systems',
    description:
      'Navigation lights, bilge pumps, wiring issues — we diagnose and fix marine electrical problems safely.',
  },
  {
    icon: '🔩',
    title: 'General Maintenance',
    description:
      'Seasonal prep, through-hull fittings, hardware replacement, and anything else your boat needs to stay shipshape.',
  },
];
---

<section id="services" class="py-24 bg-brand-cream-soft">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="text-brand-teal-ink font-semibold tracking-widest uppercase text-sm mb-3">What We Do</p>
      <h2 class="font-display text-4xl md:text-5xl text-brand-ink mb-4">Our Services</h2>
      <p class="text-brand-slate-strong text-lg max-w-xl mx-auto">
        From quick fixes to full restorations, we handle it all with the care your boat deserves.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map(service => (
        <div class="bg-brand-paper rounded-brand p-8 shadow-brand-sm hover:shadow-brand-md border border-brand-border transition-shadow group">
          <div class="text-4xl text-center mb-4">{service.icon}</div>
          <h3 class="text-xl text-center font-bold text-brand-ink mb-3 group-hover:text-brand-teal-strong transition-colors">
            {service.title}
          </h3>
          <p class="text-brand-slate-strong leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
