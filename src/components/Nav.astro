---
import { publicAsset } from '../utils/publicAsset';

const navLinks = [
  { label: 'Services', href: '#services' },
  { label: 'Why Us', href: '#why-us' },
  { label: 'Testimonials', href: '#testimonials' },
  { label: 'Contact', href: '#contact' },
];

const logoUrl = publicAsset('logo.svg');
---

<header class="fixed top-0 left-0 right-0 z-50 bg-brand-ink-deep shadow-brand-md">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo / Name -->
    <a href={import.meta.env.BASE_URL} class="flex items-center gap-3 group">
      <img
        src={logoUrl}
        alt="Hull of a Deal"
        width="40"
        height="40"
        class="h-10 w-10 shrink-0"
      />
      <div class="leading-tight">
        <span class="block text-brand-cream font-bold text-lg tracking-tight group-hover:text-brand-teal transition-colors">
          Hull of a Deal
        </span>
        <span class="block text-brand-powder text-xs font-medium tracking-widest uppercase">
          Boat Works
        </span>
      </div>
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="text-brand-powder-soft hover:text-brand-teal font-medium text-sm tracking-wide transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <a
      href="tel:+15555550100"
      class="hidden md:inline-flex items-center gap-2 bg-brand-teal hover:bg-brand-teal-strong text-brand-ink font-bold text-sm px-4 py-2 rounded-brand transition-colors"
    >
      📞 (555) 555-0100
    </a>

    <!-- Mobile menu button (hamburger — no JS for now, just shows phone) -->
    <a
      href="tel:+15555550100"
      class="md:hidden text-brand-teal font-bold text-sm"
    >
      📞 Call Us
    </a>
  </nav>
</header>
