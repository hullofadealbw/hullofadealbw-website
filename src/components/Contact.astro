---
---

<section id="contact" class="py-24 bg-gray-50">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <p class="text-gold-500 font-semibold tracking-widest uppercase text-sm mb-3">Get in Touch</p>
    <h2 class="text-4xl md:text-5xl font-extrabold text-navy-700 mb-4">Ready to Get Started?</h2>
    <p class="text-gray-500 text-lg mb-12 max-w-xl mx-auto">
      Give us a call, send a text, or shoot us an email. We'll get back to you same day and can
      usually get your boat in within the week.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-12">
      <!-- Phone -->
      <a
        href="tel:+15555550100"
        class="flex flex-col items-center gap-3 bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md hover:border-gold-400 transition-all group"
      >
        <span class="text-4xl">📞</span>
        <span class="font-bold text-navy-700 group-hover:text-gold-500 transition-colors">Call or Text</span>
        <span class="text-gray-500 text-sm">(555) 555-0100</span>
      </a>

      <!-- Email -->
      <a
        href="mailto:hello@hullofadeal.com"
        class="flex flex-col items-center gap-3 bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md hover:border-gold-400 transition-all group"
      >
        <span class="text-4xl">✉️</span>
        <span class="font-bold text-navy-700 group-hover:text-gold-500 transition-colors">Email Us</span>
        <span class="text-gray-500 text-sm">hello@hullofadeal.com</span>
      </a>

      <!-- Location -->
      <div class="flex flex-col items-center gap-3 bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
        <span class="text-4xl">📍</span>
        <span class="font-bold text-navy-700">Find Us</span>
        <span class="text-gray-500 text-sm text-center">[Your Marina / Address]<br />[City, State ZIP]</span>
      </div>
    </div>

    <div class="bg-navy-800 rounded-2xl px-8 py-6 text-white inline-block">
      <p class="text-blue-200 text-sm font-medium tracking-wide uppercase mb-1">Hours</p>
      <p class="font-semibold">Mon – Fri: 7am – 6pm &nbsp;·&nbsp; Sat: 8am – 3pm &nbsp;·&nbsp; Sun: By appointment</p>
    </div>
  </div>
</section>
