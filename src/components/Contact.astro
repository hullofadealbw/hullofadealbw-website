<section id="contact" class="py-24 bg-brand-cream-soft">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <p class="text-brand-teal-ink font-semibold tracking-widest uppercase text-sm mb-3">Get in Touch</p>
    <h2 class="font-display text-4xl md:text-5xl text-brand-ink mb-4">Ready to Get Started?</h2>
    <p class="text-brand-slate-strong text-lg mb-12 max-w-xl mx-auto">
      Give us a call, send a text, or shoot us an email. We'll get back to you same day and can
      usually get your boat in within the week.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
      <!-- Phone -->
      <a
        href="tel:+15555550100"
        class="flex flex-col items-center gap-3 bg-brand-paper rounded-brand p-8 border border-brand-border shadow-brand-sm hover:shadow-brand-md hover:border-brand-teal transition-all group"
      >
        <span class="text-4xl">📞</span>
        <span class="font-bold text-brand-ink group-hover:text-brand-teal-ink transition-colors">Call or Text</span>
        <span class="text-brand-slate-strong text-sm">(555) 555-0100</span>
      </a>

      <!-- Email -->
      <a
        href="mailto:hello@hullofadeal.com"
        class="flex flex-col items-center gap-3 bg-brand-paper rounded-brand p-8 border border-brand-border shadow-brand-sm hover:shadow-brand-md hover:border-brand-teal transition-all group"
      >
        <span class="text-4xl">✉️</span>
        <span class="font-bold text-brand-ink group-hover:text-brand-teal-ink transition-colors">Email Us</span>
        <span class="text-brand-slate-strong text-sm">hullofadealbw@gmail.com</span>
      </a>

      <!-- Location -->
      <!-- <div class="flex flex-col items-center gap-3 bg-brand-surface rounded-brand p-8 border border-brand-border shadow-brand-sm">
        <span class="text-4xl">📍</span>
        <span class="font-bold text-brand-ink">Find Us</span>
        <span class="text-brand-muted text-sm text-center">[Your Marina / Address]<br />[City, State ZIP]</span>
      </div> -->
    </div>

    <div class="bg-brand-ink-deep rounded-brand px-8 py-6 text-brand-cream inline-block">
      <p class="text-brand-powder text-sm font-medium tracking-wide uppercase mb-1">Hours</p>
      <p class="font-semibold">Mon – Fri: 9am – 6pm &nbsp;·&nbsp; Sat: 10am – 3pm &nbsp;·&nbsp; Sun: By appointment</p>
    </div>
  </div>
</section>
