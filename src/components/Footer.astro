---
import { publicAsset } from '../utils/publicAsset';

const year = new Date().getFullYear();
const logoUrl = publicAsset('logo.svg');
---

<footer class="bg-brand-ink-deep text-brand-powder py-10">
  <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-sm">
    <div class="flex items-center gap-2">
      <img
        src={logoUrl}
        alt=""
        width="32"
        height="32"
        class="h-8 w-8 shrink-0"
        aria-hidden="true"
      />
      <span class="font-bold text-brand-cream">Hull of a Deal</span>
      <span class="text-brand-powder-soft">· Boat Works</span>
    </div>
    <p class="text-brand-powder-soft">© {year} Hull of a Deal. All rights reserved.</p>
    <div class="flex gap-6">
      <a href="#services" class="hover:text-brand-teal transition-colors">Services</a>
      <a href="#contact" class="hover:text-brand-teal transition-colors">Contact</a>
      <a
        href="https://g.page/r/YOUR_GOOGLE_REVIEW_LINK"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-brand-teal transition-colors"
      >
        Google Reviews
      </a>
    </div>
  </div>
</footer>
