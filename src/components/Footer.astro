---
const year = new Date().getFullYear();
---

<footer class="bg-navy-900 text-blue-200 py-10">
  <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-sm">
    <div class="flex items-center gap-2">
      <span class="text-xl">⚓</span>
      <span class="font-bold text-white">Hull of a Deal</span>
      <span class="text-blue-400">· Marine Services</span>
    </div>
    <p class="text-blue-400">© {year} Hull of a Deal. All rights reserved.</p>
    <div class="flex gap-6">
      <a href="#services" class="hover:text-gold-400 transition-colors">Services</a>
      <a href="#contact" class="hover:text-gold-400 transition-colors">Contact</a>
      <a
        href="https://g.page/r/YOUR_GOOGLE_REVIEW_LINK"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-gold-400 transition-colors"
      >
        Google Reviews
      </a>
    </div>
  </div>
</footer>
