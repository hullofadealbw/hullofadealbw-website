---

<section class="relative bg-brand-ink-deep text-brand-cream min-h-screen flex items-center overflow-hidden">
  <!-- Background texture / wave overlay -->
  <div class="absolute inset-0 opacity-10">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" class="absolute bottom-0 w-full" preserveAspectRatio="none">
      <path fill="currentColor" fill-opacity="1" d="M0,160L48,144C96,128,192,96,288,106.7C384,117,480,171,576,176C672,181,768,139,864,117.3C960,96,1056,96,1152,112C1248,128,1344,160,1392,176L1440,192L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
    </svg>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 py-32 text-center">
    <p class="text-brand-teal font-semibold tracking-widest uppercase text-sm mb-4">
      Local · Honest · Expert
    </p>
    <h1 class="font-display text-5xl md:text-7xl leading-tight mb-6">
      Your Boat Deserves<br />
      <span class="text-brand-teal">a Hull of a Deal</span>
    </h1>
    <p class="text-brand-powder text-xl md:text-2xl max-w-2xl mx-auto mb-10 leading-relaxed">
      <span class="block italic">Don't blow your boat budget</span>
      <span class="block mt-2 not-italic">Superior boat work at affordable prices… finally!</span>
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="#services"
        class="bg-brand-teal hover:bg-brand-teal-strong text-brand-ink font-bold px-8 py-4 rounded-brand text-lg transition-colors"
      >
        See Our Services
      </a>
      <a
        href="#contact"
        class="border-2 border-brand-cream hover:border-brand-teal hover:text-brand-teal text-brand-cream font-bold px-8 py-4 rounded-brand text-lg transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </div>
</section>
