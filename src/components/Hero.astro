---

<section class="relative bg-navy-800 text-white min-h-screen flex items-center overflow-hidden">
  <!-- Background texture / wave overlay -->
  <div class="absolute inset-0 opacity-10">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" class="absolute bottom-0 w-full" preserveAspectRatio="none">
      <path fill="#ffffff" fill-opacity="1" d="M0,160L48,144C96,128,192,96,288,106.7C384,117,480,171,576,176C672,181,768,139,864,117.3C960,96,1056,96,1152,112C1248,128,1344,160,1392,176L1440,192L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
    </svg>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 py-32 text-center">
    <p class="text-gold-400 font-semibold tracking-widest uppercase text-sm mb-4">
      Local · Honest · Expert
    </p>
    <h1 class="text-5xl md:text-7xl font-extrabold leading-tight mb-6">
      Your Boat Deserves<br />
      <span class="text-gold-400">a Hull of a Deal</span>
    </h1>
    <p class="text-blue-200 text-xl md:text-2xl max-w-2xl mx-auto mb-10">
      Expert boat repair and marine services — from fiberglass fixes to full hull
      restorations. Quality work at fair prices, right here in [Your City].
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="#services"
        class="bg-gold-500 hover:bg-gold-600 text-navy-800 font-bold px-8 py-4 rounded-xl text-lg transition-colors"
      >
        See Our Services
      </a>
      <a
        href="#contact"
        class="border-2 border-white hover:border-gold-400 hover:text-gold-400 text-white font-bold px-8 py-4 rounded-xl text-lg transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </div>
</section>
